rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allows ANY user to read/write ANY data (Requested by user for local dev)
    // WARNING: DO NOT DEPLOY THIS TO PRODUCTION
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }
    
    // Split Expenses are shared documents
    match /splitExpenses/{splitExpenseId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can create/update/delete splits
    }
    
    // Global Read-Only Collections
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    match /templates/{templateId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
