rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allows ANY user to read/write ANY data (Requested by user for local dev)
    // WARNING: DO NOT DEPLOY THIS TO PRODUCTION
    match /users/{userId} {
      // Anyone authenticated can read the public profile to find users to invite
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Personal financial data remains strictly private
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Split Expenses are shared documents
    match /splitExpenses/{splitExpenseId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can create/update/delete splits
    }
    
    // Global Read-Only Collections
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    match /templates/{templateId} {
      allow read: if true;
      allow write: if true;
    }

    // --- GROUP FINANCIAL MANAGEMENT ---
    
    match /groups/{groupId} {
      // Members can read the group document
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      
      // Creating a group: must be authenticated, must be the creator, must include self in memberIds
      allow create: if request.auth != null 
                    && request.resource.data.createdBy == request.auth.uid 
                    && request.auth.uid in request.resource.data.memberIds;
      
      // Updating a group: only creator/admin can update, cannot change core metadata
      allow update: if request.auth != null 
                    && request.auth.uid == resource.data.createdBy
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.memberIds == resource.data.memberIds
                    && request.resource.data.createdAt == resource.data.createdAt;
      
      match /members/{userId} {
        // Members can read membership info
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        
        // Only allow creating a membership doc if it's the creator making themselves an ADMIN during group creation, OR if the creator is adding other members (prototyping)
        allow create: if request.auth != null 
                      && request.auth.uid == getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy;
                      
        // No arbitrary client-side modifications for now
        allow update, delete: if false;
      }
      
      match /settings/financial {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if request.auth != null && request.auth.uid == getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy;
        allow update, delete: if false;
      }
      
      match /transactions/{transactionId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow write: if false;
      }
      
      match /financialCycles/{cycleId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if request.auth != null && request.auth.uid == getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy;
        allow update, delete: if false;
        
        match /dailyJournals/{journalId} {
          allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow write: if false;
        }
      }
    }
  }
}
